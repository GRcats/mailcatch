PORT=3000
DB_HOST=localhost
DB_PORT=3306
DB_USER=mailcatch
DB_PASSWORD=change-this-password
DB_NAME=mailcatch
JWT_SECRET=replace-with-a-long-random-secret

IMAP_HOST=imap.example.com
IMAP_PORT=993
IMAP_USER=mail@example.com
IMAP_PASS=app-password

# 32바이트 키를 base64로 인코딩한 값
MAIL_CREDENTIAL_KEY=replace-with-base64-32-byte-key

# DB와 다른 드라이브 또는 NAS 공유 폴더 권장
BACKUP_PATH=E:\MailCatchBackups
BACKUP_ENCRYPTION_KEY=replace-with-another-long-random-secret
